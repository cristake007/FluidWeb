<div class="dropdown">
    <button
        class="avatar avatar-sm header-aplicatie__avatar"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        aria-label="Meniu utilizator"
    >
        <i class="ti ti-user icon" aria-hidden="true"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end">
        {% if is_granted('ROLE_ADMIN') %}
            <a
                class="dropdown-item"
                href="{{ path('administrare') }}"
                data-turbo-frame="continut-aplicatie"
            >
                <i class="ti ti-settings icon dropdown-item-icon" aria-hidden="true"></i>
                Administrare
            </a>
        {% endif %}
        <form action="{{ path('deconectare') }}" method="post" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('deconectare') }}">
            <button class="dropdown-item" type="submit">
                <i class="ti ti-logout icon dropdown-item-icon" aria-hidden="true"></i>
                Deconectare
            </button>
        </form>
    </div>
</div>
