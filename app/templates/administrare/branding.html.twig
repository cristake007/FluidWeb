{% extends 'layout/aplicatie.html.twig' %}
{% form_theme formular 'bootstrap_5_layout.html.twig' %}

{% block title %}Branding | FluidWeb{% endblock %}

{% block continut_aplicatie %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <ol class="breadcrumb breadcrumb-arrows align-items-center mb-0" aria-label="Navigare ierarhică">
                <li class="breadcrumb-item d-flex align-items-center">
                    <a class="h3 fw-normal mb-0" href="{{ path('administrare') }}" data-turbo-action="advance">Administrare</a>
                </li>
                <li class="breadcrumb-item active d-flex align-items-center" aria-current="page">
                    <h1 class="h3 mb-0">Branding</h1>
                </li>
            </ol>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card">
                        {{ form_start(formular, {attr: {novalidate: 'novalidate', 'data-turbo-action': 'advance'}}) }}
                            <div class="card-body">
                                {{ form_row(formular.numeAplicatie) }}
                                <div class="row">
                                    <div class="col-md-6">{{ form_row(formular.culoarePrincipala) }}</div>
                                    <div class="col-md-6">{{ form_row(formular.culoareSecundara) }}</div>
                                </div>
                                {{ form_row(formular.fisierLogoPrincipal) }}
                                {% if configuratie.logoPrincipal %}
                                    <img
                                        class="img-thumbnail mb-3"
                                        src="{{ path('administrare_branding_fisier', {tip: 'logo-principal'}) }}"
                                        alt="Previzualizare logo principal"
                                        data-previzualizare="logo-principal"
                                        style="max-height: 120px"
                                    >
                                {% endif %}
                                {{ form_row(formular.fisierLogoCompact) }}
                                {% if configuratie.logoCompact %}
                                    <img
                                        class="img-thumbnail mb-3"
                                        src="{{ path('administrare_branding_fisier', {tip: 'logo-compact'}) }}"
                                        alt="Previzualizare logo compact"
                                        data-previzualizare="logo-compact"
                                        style="max-height: 96px"
                                    >
                                {% endif %}
                                {{ form_row(formular.fisierFavicon) }}
                                {% if configuratie.favicon %}
                                    <img
                                        class="img-thumbnail mb-3"
                                        src="{{ path('administrare_branding_fisier', {tip: 'favicon'}) }}"
                                        alt="Previzualizare favicon"
                                        data-previzualizare="favicon"
                                        style="max-height: 64px"
                                    >
                                {% endif %}
                            </div>
                            <div class="card-footer text-end">
                                <a class="btn btn-link btn-sm text-danger" href="{{ path('administrare') }}" data-turbo-action="advance">Anulează</a>
                                <button class="btn btn-primary btn-sm" type="submit">
                                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                                    Salvează brandingul
                                </button>
                            </div>
                        {{ form_end(formular) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
