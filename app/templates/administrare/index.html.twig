{% extends 'layout/aplicatie.html.twig' %}

{% block title %}Administrare | FluidWeb{% endblock %}

{% block continut_aplicatie %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <ol class="breadcrumb breadcrumb-arrows align-items-center mb-0" aria-label="Navigare ierarhică">
                        <li class="breadcrumb-item active d-flex align-items-center" aria-current="page">
                            <h1 class="h3 mb-0">Administrare</h1>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-sm-6 col-lg-4">
                    <a
                        class="card card-link card-link-pop"
                        href="{{ path('administrare_utilizatori') }}"
                        data-turbo-action="advance"
                    >
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <span class="avatar bg-blue-lt me-3">
                                    {% include 'interfata/iconite/_utilizatori.html.twig' %}
                                </span>
                                <h2 class="card-title mb-0">Utilizatori</h2>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a
                        class="card card-link card-link-pop"
                        href="{{ path('administrare_branding') }}"
                        data-turbo-action="advance"
                    >
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <span class="avatar bg-red-lt me-3">
                                    <i class="ti ti-palette" aria-hidden="true"></i>
                                </span>
                                <h2 class="card-title mb-0">Branding</h2>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
