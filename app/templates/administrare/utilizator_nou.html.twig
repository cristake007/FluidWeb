{% extends 'layout/aplicatie.html.twig' %}
{% form_theme formular 'bootstrap_5_layout.html.twig' %}

{% block title %}Utilizator nou | FluidWeb{% endblock %}

{% block continut_aplicatie %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <ol class="breadcrumb breadcrumb-arrows align-items-center mb-0" aria-label="Navigare ierarhică">
                        <li class="breadcrumb-item d-flex align-items-center">
                            <a class="h3 fw-normal mb-0" href="{{ path('administrare') }}">Administrare</a>
                        </li>
                        <li class="breadcrumb-item d-flex align-items-center">
                            <a class="h3 fw-normal mb-0" href="{{ path('administrare_utilizatori') }}">Utilizatori</a>
                        </li>
                        <li class="breadcrumb-item active d-flex align-items-center" aria-current="page">
                            <h1 class="h3 mb-0">Utilizator nou</h1>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card">
                        {{ form_start(formular, {attr: {novalidate: 'novalidate'}}) }}
                            <div class="card-body">
                                {{ form_row(formular.prenume) }}
                                {{ form_row(formular.nume) }}
                                {{ form_row(formular.email) }}
                                {{ form_row(formular.administrator) }}
                            </div>
                            <div class="card-footer text-end">
                                <a class="btn btn-link btn-sm text-danger" href="{{ path('administrare_utilizatori') }}">Anulează</a>
                                <button class="btn btn-primary btn-sm" type="submit">
                                    <i class="ti ti-user-plus me-1" aria-hidden="true"></i>
                                    Creează utilizatorul
                                </button>
                            </div>
                        {{ form_end(formular) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
