{% extends 'layout/securitate.html.twig' %}

{% block title %}Autentificare | FluidWeb{% endblock %}

{% block continut_securitate %}
    <div class="pagina-autentificare__brand">FLUIDWEB</div>
    <h1 id="titlu-autentificare" class="pagina-autentificare__titlu">Autentificare</h1>
    <p class="pagina-autentificare__subtitlu">Introduceți datele contului pentru a continua.</p>

    {% if eroare_autentificare %}
        <div class="alert alert-danger pagina-autentificare__alerta" role="alert">
            {% if eroare_autentificare.messageKey starts with 'Too many failed login attempts' %}
                {{ eroare_autentificare.messageKey|trans(eroare_autentificare.messageData, 'security', 'ro') }}
            {% else %}
                Adresa de email sau parola este incorectă.
            {% endif %}
        </div>
    {% endif %}

    <form
        action="{{ path('autentificare') }}"
        method="post"
        data-controller="validare-formular"
        data-action="submit->validare-formular#valideaza"
        novalidate
    >
        <div class="pagina-autentificare__grup-camp">
            <label class="form-label pagina-autentificare__eticheta" for="email">
                Adresă de email
                <span class="pagina-autentificare__obligatoriu" aria-hidden="true">*</span>
                <span class="visually-hidden">(obligatoriu)</span>
            </label>
            <input
                class="form-control pagina-autentificare__camp"
                type="email"
                id="email"
                name="email"
                value="{{ ultima_adresa_email }}"
                placeholder="nume@companie.ro"
                autocomplete="username"
                aria-describedby="eroare-email"
                data-validare-formular-target="camp"
                data-mesaj-lipsa="Introduceți adresa de email."
                data-mesaj-invalid="Introduceți o adresă de email validă."
                data-action="blur->validare-formular#valideazaCamp input->validare-formular#actualizeazaDupaEditare"
                required
                autofocus
            >
            <div id="eroare-email" class="invalid-feedback" aria-live="polite">Introduceți adresa de email.</div>
        </div>

        <div class="pagina-autentificare__grup-camp">
            <label class="form-label pagina-autentificare__eticheta" for="parola">
                Parolă
                <span class="pagina-autentificare__obligatoriu" aria-hidden="true">*</span>
                <span class="visually-hidden">(obligatoriu)</span>
            </label>
            <input
                class="form-control pagina-autentificare__camp"
                type="password"
                id="parola"
                name="parola"
                placeholder="Introduceți parola"
                autocomplete="current-password"
                aria-describedby="eroare-parola"
                data-validare-formular-target="camp"
                data-mesaj-lipsa="Introduceți parola."
                data-mesaj-invalid="Introduceți parola."
                data-action="blur->validare-formular#valideazaCamp input->validare-formular#actualizeazaDupaEditare"
                required
            >
            <div id="eroare-parola" class="invalid-feedback" aria-live="polite">Introduceți parola.</div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('autentificare') }}">
        <button class="btn btn-light w-100 pagina-autentificare__buton" type="submit">Autentificare</button>
    </form>
{% endblock %}
