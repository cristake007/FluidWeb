# syntax=docker/dockerfile:1.11
FROM rust:1.97.1-slim-trixie

ENV PATH="/usr/local/cargo/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl-dev \
        nodejs \
        npm \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown \
    && OPENSSL_NO_VENDOR=1 cargo install cargo-leptos --version 0.3.6 --locked

CMD ["bash", "-c", "npm install && npm run css:build && exec cargo leptos watch"]
